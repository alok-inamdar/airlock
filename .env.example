# ---------------------------------------------------------------------------
# Airlock Firebase configuration (optional)
#
# Leave every VITE_FIREBASE_* value empty to run in Local Demo Mode. The full
# three-stage pipeline, cached demo audits, session vault, offline queue, and
# Remote Config defaults work without a Firebase project.
#
# For live cloud audits, create a Firebase project on the FREE Spark plan and
# enable: AI Logic, App Check (reCAPTCHA v3), Anonymous Auth, Firestore, and
# Remote Config. All values below are public client identifiers.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA v3 site key registered with App Check for this web app.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Optional App Check debug token. Only honored on localhost, never commit a
# real token. Leave empty to let the SDK generate a local-only debug token.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
